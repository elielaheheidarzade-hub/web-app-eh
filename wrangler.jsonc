{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-eh",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "0763c5f7-5fdf-4b63-8566-16e5245924f4","database_name": "web-app-eh" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "71946615547945fd9c87397d647947c5" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
